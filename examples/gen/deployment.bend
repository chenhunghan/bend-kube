type DeploymentCondition is Data:
  DeploymentCondition{lastTransitionTime: Maybe<&2, String>, lastUpdateTime: Maybe<&2, String>, message: Maybe<&2, String>, reason: Maybe<&2, String>, status: String, f_type: String}

def DeploymentCondition.of.go(+j: J.Json, +path: String) -> Result<&2, &2, String, DeploymentCondition>:
  do Result<&2, &2, String, DeploymentCondition>:
    v0 : Maybe<&2, String> <- T.Ty.opt(~String, ~T.Ty.str, j, "lastTransitionTime", path)
    v1 : Maybe<&2, String> <- T.Ty.opt(~String, ~T.Ty.str, j, "lastUpdateTime", path)
    v2 : Maybe<&2, String> <- T.Ty.opt(~String, ~T.Ty.str, j, "message", path)
    v3 : Maybe<&2, String> <- T.Ty.opt(~String, ~T.Ty.str, j, "reason", path)
    v4 : String <- T.Ty.req(~String, ~T.Ty.str, j, "status", path)
    v5 : String <- T.Ty.req(~String, ~T.Ty.str, j, "type", path)
    return DeploymentCondition{v0, v1, v2, v3, v4, v5}

def DeploymentCondition.of(j: J.Json, path: String) -> Result<&2, &2, String, DeploymentCondition>:
  DeploymentCondition.of.go(j, path)

def DeploymentCondition.to(t: DeploymentCondition) -> J.Json:
  match t:
    case DeploymentCondition{v0, v1, v2, v3, v4, v5}:
      T.Ty.obj([T.Ty.put_opt(~String, ~T.Ty.from_str, "lastTransitionTime", v0),
        T.Ty.put_opt(~String, ~T.Ty.from_str, "lastUpdateTime", v1),
        T.Ty.put_opt(~String, ~T.Ty.from_str, "message", v2),
        T.Ty.put_opt(~String, ~T.Ty.from_str, "reason", v3),
        T.Ty.put(~String, ~T.Ty.from_str, "status", v4),
        T.Ty.put(~String, ~T.Ty.from_str, "type", v5)])

type DeploymentStatus is Data:
  DeploymentStatus{availableReplicas: Maybe<&2, String>, collisionCount: Maybe<&2, String>, conditions: List<&2, DeploymentCondition>, observedGeneration: Maybe<&2, String>, readyReplicas: Maybe<&2, String>, replicas: Maybe<&2, String>, terminatingReplicas: Maybe<&2, String>, unavailableReplicas: Maybe<&2, String>, updatedReplicas: Maybe<&2, String>}

def DeploymentStatus.of.go(+j: J.Json, +path: String) -> Result<&2, &2, String, DeploymentStatus>:
  do Result<&2, &2, String, DeploymentStatus>:
    v0 : Maybe<&2, String> <- T.Ty.opt(~String, ~T.Ty.num, j, "availableReplicas", path)
    v1 : Maybe<&2, String> <- T.Ty.opt(~String, ~T.Ty.num, j, "collisionCount", path)
    v2 : List<&2, DeploymentCondition> <- T.Ty.list(~DeploymentCondition, ~DeploymentCondition.of, j, "conditions", path)
    v3 : Maybe<&2, String> <- T.Ty.opt(~String, ~T.Ty.num, j, "observedGeneration", path)
    v4 : Maybe<&2, String> <- T.Ty.opt(~String, ~T.Ty.num, j, "readyReplicas", path)
    v5 : Maybe<&2, String> <- T.Ty.opt(~String, ~T.Ty.num, j, "replicas", path)
    v6 : Maybe<&2, String> <- T.Ty.opt(~String, ~T.Ty.num, j, "terminatingReplicas", path)
    v7 : Maybe<&2, String> <- T.Ty.opt(~String, ~T.Ty.num, j, "unavailableReplicas", path)
    v8 : Maybe<&2, String> <- T.Ty.opt(~String, ~T.Ty.num, j, "updatedReplicas", path)
    return DeploymentStatus{v0, v1, v2, v3, v4, v5, v6, v7, v8}

def DeploymentStatus.of(j: J.Json, path: String) -> Result<&2, &2, String, DeploymentStatus>:
  DeploymentStatus.of.go(j, path)

def DeploymentStatus.to(t: DeploymentStatus) -> J.Json:
  match t:
    case DeploymentStatus{v0, v1, v2, v3, v4, v5, v6, v7, v8}:
      T.Ty.obj([T.Ty.put_opt(~String, ~T.Ty.from_num, "availableReplicas", v0),
        T.Ty.put_opt(~String, ~T.Ty.from_num, "collisionCount", v1),
        T.Ty.put_list(~DeploymentCondition, ~DeploymentCondition.to, "conditions", v2),
        T.Ty.put_opt(~String, ~T.Ty.from_num, "observedGeneration", v3),
        T.Ty.put_opt(~String, ~T.Ty.from_num, "readyReplicas", v4),
        T.Ty.put_opt(~String, ~T.Ty.from_num, "replicas", v5),
        T.Ty.put_opt(~String, ~T.Ty.from_num, "terminatingReplicas", v6),
        T.Ty.put_opt(~String, ~T.Ty.from_num, "unavailableReplicas", v7),
        T.Ty.put_opt(~String, ~T.Ty.from_num, "updatedReplicas", v8)])

# The Deployment resource, with typed spec and status; metadata stays JSON.
type Deployment is Data:
  Deployment{metadata: J.Json, spec: Maybe<&2, DeploymentSpec>, status: Maybe<&2, DeploymentStatus>}

def Deployment.res() -> C.Res:
  C.Res{"apps", "v1", "Deployment", "deployments", True{}}

def Deployment.api(scope: C.Scope) -> C.Api:
  C.Api{Deployment.res(), scope}

def Deployment.of.go(+j: J.Json, +path: String) -> Result<&2, &2, String, Deployment>:
  do Result<&2, &2, String, Deployment>:
    v0 : J.Json <- Done{J.Json.get(j, "metadata")}
    v1 : Maybe<&2, DeploymentSpec> <- T.Ty.opt(~DeploymentSpec, ~DeploymentSpec.of, j, "spec", path)
    v2 : Maybe<&2, DeploymentStatus> <- T.Ty.opt(~DeploymentStatus, ~DeploymentStatus.of, j, "status", path)
    return Deployment{v0, v1, v2}

# A watched object as a Deployment, or which field is wrong.
def Deployment.of(j: J.Json) -> Result<&2, &2, String, Deployment>:
  Deployment.of.go(j, "")

def Deployment.to(t: Deployment) -> J.Json:
  match t:
    case Deployment{v0, v1, v2}:
      T.Ty.obj([Some{J.KV{"apiVersion", J.JStr{"apps/v1"}}}, Some{J.KV{"kind", J.JStr{"Deployment"}}},
        Some{J.KV{"metadata", v0}}, T.Ty.put_opt(~DeploymentSpec, ~DeploymentSpec.to, "spec", v1), T.Ty.put_opt(~DeploymentStatus, ~DeploymentStatus.to, "status", v2)])

# A status patch body ({"status": …}) for Client.patch_status.
def Deployment.status_patch(s: DeploymentStatus) -> J.Json:
  J.Json.obj([J.KV{"status", DeploymentStatus.to(s)}])
